#!/bin/bash

# Writes the dev-only secret_key_base and LiveView signing salt to
# config/dev.secret.exs (or to the path given as the first argument).
# Each run makes new random values. An existing file is kept as it is.
# config/dev.exs reads this file. Git ignores it.

set -euo pipefail

FILE="${1:-config/dev.secret.exs}"

if [ -f "$FILE" ]; then
  echo "Kept $FILE: it exists."
  exit 0
fi

mkdir -p "$(dirname "$FILE")"

umask 077
TMP_FILE="$FILE.tmp.$$"
trap 'rm -f "$TMP_FILE"' EXIT

elixir -e '
  random = fn length ->
    length |> :crypto.strong_rand_bytes() |> Base.encode64(padding: false) |> binary_part(0, length)
  end

  File.write!(hd(System.argv()), """
  # Dev-only secrets, made by bin/dev-secrets. Git ignores this file.
  # Remove it and run bin/dev-secrets to make new values.
  [
    secret_key_base: "#{random.(64)}",
    live_view_signing_salt: "#{random.(32)}"
  ]
  """)
' "$TMP_FILE"
mv "$TMP_FILE" "$FILE"

echo "Wrote $FILE."
