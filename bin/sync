#!/bin/bash

set -e

DEBUG=false
AUTO_PUBLISH=true
PULL_MODE=false
JSON_FILE=""

# Function to print error and exit
error_exit() {
  echo "❌ Error: $1" >&2
  exit 1
}

# Function to log debug info
log_debug() {
  if [ "$DEBUG" = true ]; then
    echo "🔍 $1"
  fi
}

# Parse arguments
while [[ $# -gt 0 ]]; do
  case $1 in
    --debug)
      DEBUG=true
      shift
      ;;
    --publish)
      if [[ "$2" == "false" ]]; then
        AUTO_PUBLISH=false
      fi
      shift 2
      ;;
    --pull)
      PULL_MODE=true
      shift
      ;;
    *)
      if [[ -z "$JSON_FILE" ]]; then
        JSON_FILE="$1"
      else
        error_exit "Unexpected argument: $1"
      fi
      shift
      ;;
  esac
done

# Validate required file argument
if [[ -z "$JSON_FILE" ]]; then
  error_exit "Usage: bin/sync <json-file> [--pull] [--publish false] [--debug]"
fi

# Validate .env file
if [[ ! -f ".env" ]]; then
  error_exit ".env file not found in project root. Please create it and define PEEK_APP_REGISTRY_URL and PEEK_APP_REGISTRY_AUTH_TOKEN."
fi

# Print the value of KEY from .env. The file is read as KEY=VALUE lines; it is not run,
# so ${VAR} references are not expanded.
# Accepts an optional "export " prefix and single or double quotes around the value.
# Removes a " # comment" after the value. The last line for KEY wins.
read_env_value() {
  local key=$1 line value="" found=""
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    if [[ "$line" =~ ^[[:space:]]*(export[[:space:]]+)?${key}[[:space:]]*=(.*)$ ]]; then
      value="${BASH_REMATCH[2]}"
      value="${value#"${value%%[![:space:]]*}"}"
      if [[ "$value" =~ ^\"([^\"]*)\"[[:space:]]*(#.*)?$ ]] || [[ "$value" =~ ^\'([^\']*)\'[[:space:]]*(#.*)?$ ]]; then
        value="${BASH_REMATCH[1]}"
      else
        value="${value%%[[:space:]]#*}"
        value="${value%"${value##*[![:space:]]}"}"
      fi
      found=1
    fi
  done < .env
  [[ -n "$found" ]] && printf '%s' "$value"
  return 0
}

# A value in .env wins over the same variable in the environment.
log_debug "Reading .env file"
URL=$(read_env_value PEEK_APP_REGISTRY_URL)
TOKEN=$(read_env_value PEEK_APP_REGISTRY_AUTH_TOKEN)
URL=${URL:-$PEEK_APP_REGISTRY_URL}
TOKEN=${TOKEN:-$PEEK_APP_REGISTRY_AUTH_TOKEN}

# Validate required values
[[ -z "$URL" ]] && error_exit "Missing PEEK_APP_REGISTRY_URL in .env"
[[ -z "$TOKEN" ]] && error_exit "Missing PEEK_APP_REGISTRY_AUTH_TOKEN in .env"

# Print a curl config with the Authorization header. curl reads it on stdin (--config -),
# so the token is not in the curl command line.
auth_config() {
  local bs='\' dq='"' escaped
  escaped=${TOKEN//"$bs"/"$bs$bs"}
  escaped=${escaped//"$dq"/"$bs$dq"}
  printf 'header = "Authorization: Bearer %s"\n' "$escaped"
}

log_debug "Using Registry URL: $URL"
log_debug "Using Auth Token: Bearer [REDACTED]"
log_debug "Using JSON File: $JSON_FILE"

# Check for JSON file
if [[ ! -f "$JSON_FILE" ]]; then
  error_exit "$JSON_FILE not found"
fi

# Extract app ID from JSON file
APP_ID=$(jq -r '.data.app.id // empty' "$JSON_FILE")
if [[ -z "$APP_ID" ]]; then
  error_exit "No app ID found in $JSON_FILE at .data.app.id"
fi

log_debug "App ID: $APP_ID"

# Handle --pull mode: fetch from registry and update local file
if [ "$PULL_MODE" = true ]; then
  # Check for uncommitted changes to the file
  if git diff --quiet "$JSON_FILE" 2>/dev/null; then
    HAS_UNCOMMITTED=false
  else
    HAS_UNCOMMITTED=true
  fi

  # Also check staged changes
  if git diff --cached --quiet "$JSON_FILE" 2>/dev/null; then
    HAS_STAGED=false
  else
    HAS_STAGED=true
  fi

  echo
  echo "📥 Ready to pull from registry:"
  echo "    File to overwrite: $JSON_FILE"
  echo "    App ID: $APP_ID"
  echo "    Registry URL: $URL"
  echo "    Endpoint: /apps/$APP_ID/export"
  echo

  if [ "$HAS_UNCOMMITTED" = true ] || [ "$HAS_STAGED" = true ]; then
    echo "⚠️  WARNING: $JSON_FILE has uncommitted changes that will be lost!"
    echo
    git diff --stat "$JSON_FILE" 2>/dev/null || true
    git diff --cached --stat "$JSON_FILE" 2>/dev/null || true
    echo
    read -p "Are you SURE you want to discard local changes and overwrite? (yes/no): " CONFIRM
  else
    read -p "This will overwrite $JSON_FILE with the registry version. Continue? (yes/no): " CONFIRM
  fi

  if [[ "$CONFIRM" != "yes" ]]; then
    echo "Aborted."
    exit 1
  fi
  echo

  EXPORT_URL="$URL/apps/$APP_ID/export"
  log_debug "Fetching from $EXPORT_URL"

  set +e
  RESPONSE=$(auth_config | curl --silent --show-error --write-out "\nHTTP_STATUS:%{http_code}" \
    --config - \
    --request GET \
    --url "$EXPORT_URL" \
    --header "User-Agent: sync-script/1.0")
  CURL_EXIT=$?
  set -e

  HTTP_STATUS=$(echo "$RESPONSE" | sed -n 's/.*HTTP_STATUS://p')
  RESPONSE_BODY=$(echo "$RESPONSE" | sed '/HTTP_STATUS:/d')

  if [ "$DEBUG" = true ]; then
    echo "📥 Raw response from server:"
    echo "$RESPONSE_BODY"
    echo "🔢 HTTP status code: $HTTP_STATUS"
  fi

  if [ "$CURL_EXIT" -ne 0 ] || [[ "$HTTP_STATUS" -ge 400 ]]; then
    echo "❌ Request failed with status $HTTP_STATUS"
    echo "$RESPONSE_BODY"
    exit 1
  fi

  # Write the response to file
  echo "$RESPONSE_BODY" | jq '.' > "$JSON_FILE"
  echo "✅ Updated $JSON_FILE from registry"
  exit 0
fi

if [ "$DEBUG" = true ]; then
  echo "📄 Contents of $JSON_FILE:"
  cat "$JSON_FILE"
  echo
fi

# Confirm action
echo
echo "📤 Ready to sync:"
echo "    File: $JSON_FILE"
echo "    Registry: $URL"
echo "    Auto-publish: $AUTO_PUBLISH"
echo
read -p "Are you sure you want to continue? (yes/no): " CONFIRM
if [[ "$CONFIRM" != "yes" ]]; then
  echo "Aborted."
  exit 1
fi
echo

# Function to send request
send_request() {
  local ALLOW_PROD_FLAG=$1
  local FINAL_URL="$URL/apps/upsert?auto-publish=$AUTO_PUBLISH"

  if [[ "$ALLOW_PROD_FLAG" == "true" ]]; then
    FINAL_URL="$FINAL_URL&allow-prod=true"
  fi

  log_debug "Sending POST request to $FINAL_URL"

  set +e
  RESPONSE=$(auth_config | curl --silent --show-error --write-out "\nHTTP_STATUS:%{http_code}" \
    --config - \
    --request POST \
    --url "$FINAL_URL" \
    --header "Content-Type: application/json" \
    --header "User-Agent: sync-script/1.0" \
    --data "@$JSON_FILE")
  CURL_EXIT=$?
  set -e

  if [ "$DEBUG" = true ]; then
    echo "📥 Raw HTTP response (including HTTP_STATUS marker):"
    echo "$RESPONSE"
    echo
  fi

  HTTP_STATUS=$(echo "$RESPONSE" | sed -n 's/.*HTTP_STATUS://p')
  RESPONSE_BODY=$(echo "$RESPONSE" | sed '/HTTP_STATUS:/d')
}

# Initial request
send_request "false"

# Check if 403 due to missing allow-prod
ERROR_DETAIL=""
if [[ "$HTTP_STATUS" == "403" ]]; then
  # Some error responses are not JSON:API-style arrays; guard jq so it can't blow up the script
  ERROR_DETAIL=$(echo "$RESPONSE_BODY" | jq -r '.errors.detail // .errors[0].detail // empty' 2>/dev/null || echo "")
fi

if [[ "$HTTP_STATUS" == "403" && "$ERROR_DETAIL" == "Auto-publish is not allowed in production without allow-prod=true" ]]; then
  echo
  echo "⚠️  Attempting to auto-publish this app would create a new production version."
  read -p "Are you sure you want to proceed with production publish? (yes/no): " PUBLISH_CONFIRM
  if [[ "$PUBLISH_CONFIRM" != "yes" ]]; then
    echo "Aborted."
    exit 1
  fi

  echo
  echo "🔁 Retrying with allow-prod=true..."
  send_request "true"
fi

if [ "$DEBUG" = true ]; then
  echo "📥 Raw response from server:"
  echo "$RESPONSE_BODY"
  echo "🔢 HTTP status code: $HTTP_STATUS"
fi

if [ "$CURL_EXIT" -ne 0 ] || [[ "$HTTP_STATUS" -ge 400 ]]; then
  echo "❌ Request failed with status $HTTP_STATUS"
  echo "$RESPONSE_BODY"
  exit 1
fi

# Extract action
ACTION=$(echo "$RESPONSE_BODY" | jq -r '.data.action')

# Check for shared_secret_key and notify user
SECRET=$(echo "$RESPONSE_BODY" | jq -r '.data.app.shared_secret_key // empty')

if [[ -n "$SECRET" ]]; then
  echo
  echo "🔐 IMPORTANT: A new shared secret key was generated!"
  echo "    → $SECRET"
  echo
  echo "💾 Save this secret in a secure place. It will NOT be shown again."
  echo
  echo "📌 Deployment Instructions:"
  echo "  • For PRODUCTION: Set this secret as the environment variable:"
  echo "        PEEK_APP_SECRET"
  echo
  echo "  • For SANDBOX / LOCAL / DEV: This is the shared sandbox secret."
  echo "        No need to configure this in each environment."
  echo "        Your app runtime should fallback to this shared value if not overridden."
  echo
fi

# Clean and save the updated payload back to file
CLEANED=$(echo "$RESPONSE_BODY" | jq 'del(.data.action, .data.app.shared_secret_key)')
echo "$CLEANED" > "$JSON_FILE"

echo "✅ Complete: action $ACTION"
